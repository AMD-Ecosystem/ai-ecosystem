# Variables of the form ${<variable>} are substituted, currently the following
# list is supported:
#   - ${branch} (or {branch}) the name of the current branch
#   - ${url} (or {url}) github url of the current project
#   - ${project:<project_name>} base url of the documentation of <project_name>
#     based on intersphinx_mapping.
# These comments will also be removed.
defaults:
    numbered: False
    maxdepth: 6
root: index.md
subtrees:
    - entries:
          - url: https://rocm.docs.amd.com/en/latest/compatibility/compatibility-matrix.html
            title: ROCm compatibility matrix
    - caption: Deep learning frameworks
      entries:
          - file: frameworks/pytorch/install.rst
            title: Install PyTorch
          - file: frameworks/jax/install.rst
            title: Install JAX
          - file: frameworks/tensorflow/install.rst
            title: Install TensorFlow
    - caption: Inference
      entries:
          - file: inference/vllm.rst
            title: vLLM
          - file: inference/sglang.rst
            title: SGLang
          - url: https://rocm.docs.amd.com/projects/atom
            title: ATOM
          - file: inference/migraphx.rst
            title: MIGraphX
          - file: inference/onnxruntime.rst
            title: ONNX Runtime
          - file: inference/xdit.rst
            title: xDiT diffusion inference
          - file: inference/comfy.rst
            title: ComfyUI image generation
    - caption: Distributed inference
      entries:
          - url: https://rocm.docs.amd.com/projects/infera
            title: Infera
          - file: inference/distributed/vllm-mori-recipe.md
            title: vLLM with MoRI recipe
          - file: inference/distributed/sglang-mori-recipe.md
            title: SGLang with MoRI recipe
    - caption: Training
      entries:
          - url: https://rocm.docs.amd.com/projects/primus
            title: Primus
    - caption: GPU kernel development
      entries:
          - url: https://rocm.docs.amd.com/projects/FlyDSL
            title: FlyDSL
          - file: optimization/optimize-triton-kernels.rst
            title: Optimize Triton kernels
          - file: optimization/optimize-with-composable-kernel.md
            title: Optimize with Composable Kernel
    - caption: Optimization
      entries:
          - file: optimization/workload-optimization.rst
            title: Workload optimization
          - file: optimization/vllm-v1-optimization.rst
            title: vLLM V1 performance optimization
          - file: optimization/model-quantization.rst
            title: Model quantization techniques
          - file: optimization/model-acceleration-libs.rst
            title: Model acceleration libraries
    - caption: Tutorials
      entries:
          - url: https://developer.amd.com/playbooks
            title: AI Playbooks
          - url: https://rocm.docs.amd.com/projects/ai-developer-hub
            title: AI Developer Hub
    - caption: Reference
      entries:
          - file: system-setup/index.rst
            title: System setup for AI workloads
            entries:
                - file: system-setup/prerequisite-system-validation.rst
                  title: Prerequisite system validation
                - file: system-setup/system-health-checks.rst
                  title: System health checks
                - file: system-setup/multi-node-setup.rst
                  title: Multi-node training setup
